{
  "id": "logic_aggregation_counter_skipped_on_branch",
  "name": "Aggregation counter not updated on specific branch",
  "category": "Logic",
  "scope": "intra_method_aggregation",
  "language": "java",
  "description": "In a loop or multi-branch aggregation, a counter or total is supposed to reflect all processed items. The bug introduces or modifies a branch such that some items are processed but not accounted for in the aggregate (e.g., filtered-but-still-logged items, or a fast path that forgets to increment). This yields totals that are smaller than expected while the individual processing still occurs.",
  "structure_constraints": {
    "required_elements": [
      "loop_over_collection_of_items",
      "aggregation_variable_used_in_assertion_or_return_value",
      "at_least_two_branches_in_loop_body_handling_items_differently"
    ],
    "forbidden_elements": [
      "removing_all_increments_from_aggregation",
      "introducing_new_counter_that_is_never_used",
      "branches_that_do_not_touch_any_item_related_state"
    ]
  },
  "runtime_effect": {
    "exception_type": null,
    "typical_failure_signals": [
      "assertEquals_on_total_count_or_sum_fails",
      "metrics_reported_lower_than_number_of_processed_items",
      "ratio_or_average_computed_from_wrong_denominator"
    ]
  },
  "trigger_conditions": {
    "test_shape": "Tests that both inspect per-item effects and assert aggregate counts or totals.",
    "input_properties": "At least one item that goes through the branch where the counter is not updated but other work still happens."
  },
  "example": {
    "description": "A loop processes events and returns a processed-count used by tests. A fast-path branch for \"verbose\" events still performs the same side effects (normalization + handler call + audit log) but forgets to increment the aggregation counter. The per-item work occurs, yet the final count is lower than expected, causing assertEquals failures on totals and derived ratios.",
    "buggy_snippet": [
      "import java.util.ArrayList;",
      "import java.util.List;",
      "import java.util.Locale;",
      "",
      "public final class EventProcessor {",
      "  public int process(List<Event> events, Metrics metrics) {",
      "    int processed = 0;",
      "    int errors = 0;",
      "    for (Event e : events) {",
      "      if (e == null) {",
      "        errors++;",
      "        metrics.recordError(\"null\");",
      "        continue;",
      "      }",
      "",
      "      String type = normalizeType(e.getType());",
      "      if (isVerbose(type)) {",
      "        metrics.recordVerbose(type);",
      "        audit(e, type, metrics);",
      "        handle(e, type, metrics);",
      "      } else {",
      "        handle(e, type, metrics);",
      "        processed++;",
      "      }",
      "    }",
      "    metrics.setProcessed(processed);",
      "    metrics.setErrors(errors);",
      "    return processed;",
      "  }",
      "",
      "  private String normalizeType(String t) {",
      "    if (t == null) return \"unknown\";",
      "    String s = t.trim().toLowerCase(Locale.ROOT);",
      "    return s.isEmpty() ? \"unknown\" : s;",
      "  }",
      "",
      "  private boolean isVerbose(String type) {",
      "    return type.startsWith(\"debug\") || type.startsWith(\"trace\");",
      "  }",
      "",
      "  private void audit(Event e, String type, Metrics m) {",
      "    String id = e.getId();",
      "    if (id == null) id = \"?\";",
      "    m.addAuditLine(type + \":\" + id);",
      "  }",
      "",
      "  private void handle(Event e, String type, Metrics m) {",
      "    if (e.getPayload() == null) {",
      "      m.recordError(\"missing_payload\");",
      "      return;",
      "    }",
      "    m.recordHandled(type);",
      "  }",
      "",
      "  public static final class Event {",
      "    private final String id;",
      "    private final String type;",
      "    private final String payload;",
      "    public Event(String id, String type, String payload) {",
      "      this.id = id;",
      "      this.type = type;",
      "      this.payload = payload;",
      "    }",
      "    public String getId() { return id; }",
      "    public String getType() { return type; }",
      "    public String getPayload() { return payload; }",
      "  }",
      "",
      "  public static final class Metrics {",
      "    private int processed;",
      "    private int errors;",
      "    private final List<String> audit = new ArrayList<>();",
      "    private int handled;",
      "    private int verbose;",
      "    private int errorCount;",
      "    public void recordHandled(String type) { handled++; }",
      "    public void recordVerbose(String type) { verbose++; }",
      "    public void recordError(String code) { errorCount++; }",
      "    public void addAuditLine(String line) { audit.add(line); }",
      "    public void setProcessed(int processed) { this.processed = processed; }",
      "    public void setErrors(int errors) { this.errors = errors; }",
      "    public int getProcessed() { return processed; }",
      "    public int getErrors() { return errors; }",
      "    public int getHandled() { return handled; }",
      "    public int getVerbose() { return verbose; }",
      "    public int getErrorCount() { return errorCount; }",
      "    public List<String> getAudit() { return audit; }",
      "  }",
      "}"
    ]
  },
