{
  "id": "logic_predicate_inversion_in_guard",
  "name": "Predicate inversion in critical guard",
  "category": "Logic",
  "scope": "intra_method_branch_condition",
  "language": "java",
  "description": "A boolean predicate used to guard important logic is inverted or altered in a subtle way. For example, a check for non-empty input becomes a check for empty input, or a safety condition is negated. The code still compiles, branches look plausible, but the semantics flip which path handles which inputs, causing assertions and invariants to fail.",
  "structure_constraints": {
    "required_elements": [
      "if_or_else_block_guarding_non_trivial_logic",
      "condition_based_on_collection_size_or_status_flag",
      "tests_that_distinguish_between_valid_and_invalid_input_cases"
    ],
    "forbidden_elements": [
      "conditions_that_are_constant_true_or_false_after_modification",
      "completely_removing_the_guard_and_inlining_the_body",
      "branches_with_no_observable_effect"
    ]
  },
  "runtime_effect": {
    "exception_type": null,
    "typical_failure_signals": [
      "assertFalse_or_assertTrue_on_status_flags_fail",
      "valid_inputs_treated_as_errors_or_vice_versa",
      "unexpected_empty_result_sets_or_unfiltered_outputs"
    ]
  },
  "trigger_conditions": {
    "test_shape": "Tests that feed different categories of inputs (valid/invalid, empty/non-empty) and assert different behavior for each.",
    "input_properties": "At least one test relying on the original guard semantics (e.g., only run logic when list is non-empty)."
  },
  "example": {
    "description": "A batch processor uses a guard based on collection size and a status flag to decide whether to execute non-trivial processing (dedup + validation + commit). A subtle predicate inversion flips the semantics: valid non-empty batches are treated as skippable while empty batches fall through into processing, producing unexpected empty outputs and status-flag assertion failures.",
    "buggy_snippet": [
      "import java.util.ArrayList;",
      "import java.util.HashSet;",
      "import java.util.List;",
      "import java.util.Set;",
      "",
      "public final class BatchProcessor {",
      "  public Result process(List<Item> items, boolean strictMode) {",
      "    Result r = new Result();",
      "    if (items != null && !items.isEmpty()) {",
      "      r.setSkipped(true);",
      "      r.addLog(\"skip non-empty batch\");",
      "      return r;",
      "    }",
      "",
      "    List<Item> dedup = deduplicate(items);",
      "    if (strictMode && hasInvalid(dedup)) {",
      "      r.setOk(false);",
      "      r.addLog(\"invalid item\");",
      "      return r;",
      "    }",
      "",
      "    int committed = commitAll(dedup);",
      "    r.setOk(true);",
      "    r.setCommitted(committed);",
      "    r.setSkipped(false);",
      "    return r;",
      "  }",
      "",
      "  private List<Item> deduplicate(List<Item> items) {",
      "    List<Item> out = new ArrayList<>();",
      "    Set<String> seen = new HashSet<>();",
      "    if (items == null) return out;",
      "    for (Item it : items) {",
      "      if (it == null) continue;",
      "      String id = it.getId();",
      "      if (id == null) continue;",
      "      if (seen.add(id)) {",
      "        out.add(it);",
      "      }",
      "    }",
      "    return out;",
      "  }",
      "",
      "  private boolean hasInvalid(List<Item> items) {",
      "    for (Item it : items) {",
      "      if (it == null) return true;",
      "      if (it.getId() == null || it.getPayload() == null) return true;",
      "      if (it.getPayload().length() == 0) return true;",
      "    }",
      "    return false;",
      "  }",
      "",
      "  private int commitAll(List<Item> items) {",
      "    int n = 0;",
      "    for (Item it : items) {",
      "      if (it != null) n++;",
      "    }",
      "    return n;",
      "  }",
      "",
      "  public static final class Item {",
      "    private final String id;",
      "    private final String payload;",
      "    public Item(String id, String payload) {",
      "      this.id = id;",
      "      this.payload = payload;",
      "    }",
      "    public String getId() { return id; }",
      "    public String getPayload() { return payload; }",
      "  }",
      "",
      "  public static final class Result {",
      "    private boolean ok;",
      "    private boolean skipped;",
      "    private int committed;",
      "    private final List<String> logs = new ArrayList<>();",
      "    public boolean isOk() { return ok; }",
      "    public boolean isSkipped() { return skipped; }",
      "    public int getCommitted() { return committed; }",
      "    public List<String> getLogs() { return logs; }",
      "    public void setOk(boolean ok) { this.ok = ok; }",
      "    public void setSkipped(boolean skipped) { this.skipped = skipped; }",
      "    public void setCommitted(int committed) { this.committed = committed; }",
      "    public void addLog(String s) { logs.add(s); }",
      "  }",
      "}"
    ]
  },
