{
  "id": "npe_collection_element_lazily_nullified",
  "name": "Lazy nullification of collection element leading to NPE",
  "category": "NPE",
  "scope": "inter_procedural_or_intra_method_collection_flow",
  "language": "java",
  "description": "Code maintains a collection (List, Map, cache, pool) of objects that are iterated over or looked up later. A lazily executed maintenance path sets some elements to null (e.g., as part of eviction, reset, or error handling) but does not update all call sites that still assume non-null. Later iteration or lookup dereferences the element without null-check, causing NPE.",
  "structure_constraints": {
    "required_elements": [
      "collection_field_or_local_holding_reference_elements",
      "maintenance_or_cleanup_code_that_iterates_or_updates_collection",
      "separate_read_path_that_iterates_or_accesses_element",
      "element_is_dereferenced_without_null_check"
    ],
    "forbidden_elements": [
      "collection_clear_calls_that_wipe_entire_collection",
      "global_null_checks_before_every_access",
      "obviously_unreachable_maintenance_code"
    ]
  },
  "runtime_effect": {
    "exception_type": "java.lang.NullPointerException",
    "typical_stacktrace_signals": [
      "iteration_method_like_forEach_or_for_loop",
      "method_names_like_refresh_cleanup_or_evict",
      "getter_or_accessor_on_collection_element"
    ]
  },
  "trigger_conditions": {
    "test_shape": "Tests that first populate or use the collection, then trigger a path that causes lazy maintenance, and finally read from the collection again.",
    "input_properties": "At least one element that is nullified by maintenance code but still reached by a later read/iteration."
  },
  "example": {
    "description": "A registry keeps a List of cached handlers used by a hot-path dispatch. A periodic maintenance step lazily nullifies inactive/expired handlers (leaving null holes instead of removing). The later dispatch and snapshot paths still assume elements are non-null and dereference them without a null-check, causing NullPointerException after maintenance runs.",
    "buggy_snippet": [
      "import java.time.Instant;",
      "import java.util.ArrayList;",
      "import java.util.List;",
      "import java.util.Locale;",
      "",
      "public final class HandlerRegistry {",
      "  private final List<HandlerSlot> slots = new ArrayList<>();",
      "  private volatile long lastMaintenanceEpochMs = 0L;",
      "",
      "  public void register(String key, Handler handler, long ttlMs) {",
      "    slots.add(new HandlerSlot(key, handler, System.currentTimeMillis() + ttlMs));",
      "  }",
      "",
      "  public void onEvent(Event e) {",
      "    maybeMaintain(e.getNowEpochMs());",
      "    dispatchAll(e);",
      "  }",
      "",
      "  private void dispatchAll(Event e) {",
      "    String topic = e.getTopic().toLowerCase(Locale.ROOT);",
      "    for (HandlerSlot s : slots) {",
      "      if (topic.startsWith(s.keyPrefix())) {",
      "        s.handler().handle(e);",
      "      }",
      "    }",
      "  }",
      "",
      "  public List<String> snapshotHandlerNames(long nowEpochMs) {",
      "    maybeMaintain(nowEpochMs);",
      "    List<String> out = new ArrayList<>();",
      "    for (HandlerSlot s : slots) {",
      "      out.add(s.handler().name());",
      "    }",
      "    return out;",
      "  }",
      "",
      "  private void maybeMaintain(long nowEpochMs) {",
      "    if (nowEpochMs - lastMaintenanceEpochMs < 1000) {",
      "      return;",
      "    }",
      "    lastMaintenanceEpochMs = nowEpochMs;",
      "    cleanupInactiveOrExpired(nowEpochMs);",
      "  }",
      "",
      "  private void cleanupInactiveOrExpired(long nowEpochMs) {",
      "    for (int i = 0; i < slots.size(); i++) {",
      "      HandlerSlot s = slots.get(i);",
      "      if (s != null && (s.isInactive() || s.isExpired(nowEpochMs))) {",
      "        slots.set(i, null);",
      "      }",
      "    }",
      "  }",
      "",
      "  public static final class Event {",
      "    private final String topic;",
      "    private final long nowEpochMs;",
      "",
      "    public Event(String topic) {",
      "      this.topic = topic;",
      "      this.nowEpochMs = Instant.now().toEpochMilli();",
      "    }",
      "",
      "    public String getTopic() {",
      "      return topic;",
      "    }",
      "",
      "    public long getNowEpochMs() {",
      "      return nowEpochMs;",
      "    }",
      "  }",
      "",
      "  public interface Handler {",
      "    void handle(Event e);",
      "    String name();",
      "  }",
      "",
      "  public static final class HandlerSlot {",
      "    private final String keyPrefix;",
      "    private final Handler handler;",
      "    private final long expiresAtEpochMs;",
      "    private boolean inactive;",
      "",
      "    public HandlerSlot(String keyPrefix, Handler handler, long expiresAtEpochMs) {",
      "      this.keyPrefix = keyPrefix;",
      "      this.handler = handler;",
      "      this.expiresAtEpochMs = expiresAtEpochMs;",
      "      this.inactive = false;",
      "    }",
      "",
      "    public String keyPrefix() {",
      "      return keyPrefix;",
      "    }",
      "",
      "    public Handler handler() {",
      "      return handler;",
      "    }",
      "",
      "    public boolean isInactive() {",
      "      return inactive;",
      "    }",
      "",
      "    public void markInactive() {",
      "      this.inactive = true;",
      "    }",
      "",
      "    public boolean isExpired(long nowEpochMs) {",
      "      return nowEpochMs >= expiresAtEpochMs;",
      "    }",
      "  }",
      "}"
    ]
  },
